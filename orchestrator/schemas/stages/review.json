{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review",
  "description": "Stage output contract: the PR was reviewed against the task goal and code quality.",
  "type": "object",
  "required": ["approved", "issues"],
  "properties": {
    "approved": {"type": "boolean"},
    "issues": {
      "type": "array",
      "items": {"type": "string"},
      "description": "blocking issues (empty when approved)"
    },
    "non_blocking": {
      "type": "array",
      "description": "findings that do NOT block approval but should be tracked as follow-ups; the engine files each as a deferred-scope issue at finalize (empty if none)",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {"type": "string", "description": "one-line issue title"},
          "detail": {"type": "string", "description": "what/why/where — the follow-up issue body"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
