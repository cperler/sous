[project]
name = "{{NAME}}"
version = "0.1.0"
description = "{{DESCRIPTION}}"
requires-python = ">=3.11"
dependencies = []

[dependency-groups]
dev = [
    "mypy>=1.11",
    "pytest>=8.0",
    "ruff>=0.6",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{PACKAGE}}"]

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.ruff]
line-length = 100
src = ["src", "tests"]

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B"]

# `files` is what makes the bare `uv run mypy` (no path arguments) check the right tree —
# the harness's review stage shells the command as declared, with no arguments to add.
# It lists BOTH trees on purpose: `orchestrator-scaffold --detect` writes the adapter's
# typecheck command as `uv run python -m mypy .`, so bare and dotted invocations must agree or the
# gate would check a different tree than this file claims. Starting strict-and-complete is
# cheap on a new project; narrow it later if a tree becomes genuinely impractical.
[tool.mypy]
files = ["src", "tests"]
python_version = "3.11"
strict = true
